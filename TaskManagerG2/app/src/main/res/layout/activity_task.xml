
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TaskActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtId_Task"
                        android:text="@string/task_id" />

                    <EditText
                        android:id="@+id/txtId_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:inputType="text"
                        android:importantForAutofill="no" />

                    <ImageButton
                        android:id="@+id/btnSearch_Task"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/task_search"
                        app:srcCompat="@android:drawable/ic_menu_search" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtTitle_Task"
                        android:text="@string/task_title" />

                    <EditText
                        android:id="@+id/txtTitle_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:inputType="textCapSentences"
                        android:importantForAutofill="no" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtDescription_Task"
                        android:text="@string/task_description" />

                    <EditText
                        android:id="@+id/txtDescription_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:inputType="textCapSentences"
                        android:importantForAutofill="no" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/tvDueDate_Task"
                        android:text="@string/task_due_date" />

                    <TextView
                        android:id="@+id/tvDueDate_Task"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:background="?android:attr/editTextBackground" />

                    <ImageButton
                        android:id="@+id/btnDueDate_Task"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/task_select_date"
                        app:srcCompat="@android:drawable/ic_menu_my_calendar" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtStatus_Task"
                        android:text="@string/task_status" />

                    <EditText
                        android:id="@+id/txtStatus_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtPriority_Task"
                        android:text="@string/task_priority" />

                    <EditText
                        android:id="@+id/txtPriority_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtAssignTo_Task"
                        android:text="@string/task_assigned_to" />

                    <EditText
                        android:id="@+id/txtAssignTo_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:inputType="textPersonName"
                        android:importantForAutofill="no" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/txtObservation_Task"
                        android:text="@string/task_notes" />

                    <EditText
                        android:id="@+id/txtObservation_Task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:minLines="2"
                        android:gravity="start|top"
                        android:inputType="textMultiLine"
                        android:importantForAutofill="no" />
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave_Task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/task_save" />

                <Button
                    android:id="@+id/btnDelete_Task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/task_delete" />

                <Button
                    android:id="@+id/btnCancel_Task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/task_cancel" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
